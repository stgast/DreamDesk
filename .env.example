# ============================================
# DreamDesk — Переменные окружения
# Скопируйте этот файл в .env и заполните значения
# ============================================

# PostgreSQL — строка подключения к базе данных
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/dreamdesk?schema=public"

# Google Gemini — API-ключ для AI-ассистента
# Получите на https://aistudio.google.com/apikey
GEMINI_API_KEY="ваш_ключ_gemini"
