// ============================================
// DreamDesk — Prisma Schema
// ============================================
// Supabase: пул (6543 + pgbouncer) для приложения, direct (5432) для migrate/db push
//
// DATABASE_URL  — Transaction pooler
// DIRECT_URL    — Session mode (обязателен для prisma migrate / db push)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Категория товаров (Мониторы, Клавиатуры, Мыши и т.д.)
model Category {
  id       String    @id @default(cuid())
  name     String    @unique  // "Мониторы", "Клавиатуры" и т.д.
  slug     String    @unique  // "monitors", "keyboards" — для фильтрации
  icon     String?            // Название иконки из lucide-react
  order    Int       @default(0)  // Порядок отображения в UI

  products Product[]

  createdAt DateTime @default(now())
}

// Товар (конкретная периферия)
model Product {
  id             String   @id @default(cuid())
  name           String              // "LG 27UL850-W"
  description    String?             // Краткое описание
  price          Float               // Цена в рублях
  imageUrl       String?             // URL изображения
  connectionType String              // "USB", "XLR", "Wireless", "HDMI", "USB-C" и т.д.
  features       String   @default("[]") // JSON-массив характеристик: ["4K", "HDR", "IPS"]
  weight         Float?              // Вес в граммах (мыши/лёгкая периферия) или граммы для тяжёлых устройств

  // Габариты мыши (мм) — для сравнения форм на /compare; у остальных категорий null
  lengthMm    Float?
  widthMm     Float?
  heightMm    Float?
  humpPercent Float?   // 0–100: положение пика корпуса по длине (нос слева), как на EloShapes

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())

  @@index([categoryId])
}

// Пользователь
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  nickname      String?   @unique  // Уникальный никнейм для входа
  emailVerified DateTime?
  image         String?
  password      String?   // Хешированный пароль для Credentials (null для OAuth)

  accounts      Account[]
  sessions      Session[]
  setups        Setup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NextAuth: учётные записи от провайдеров (Google, Credentials и т.д.)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth: сессии
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth: верификация email
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Сохранённая конфигурация (сетап)
model Setup {
  id         String   @id @default(cuid())
  name       String   // Название сборки, например "My Gaming Setup"
  items      String   @default("[]") // JSON-строка со списком ID товаров
  totalPrice Float

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}
