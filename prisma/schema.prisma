// ============================================
// DreamDesk — Prisma Schema
// ============================================
// База данных: PostgreSQL (продакшен) / SQLite (разработка)
//
// Для PostgreSQL в .env:
//   DATABASE_URL="postgresql://user:password@localhost:5432/dreamdesk?schema=public"
//
// Для SQLite (по умолчанию для разработки):
//   DATABASE_URL="file:./dev.db"
// ============================================

generator client {
  provider = "prisma-client-js"
}

// Переключите provider на "postgresql" при деплое на сервер с PostgreSQL
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Категория товаров (Мониторы, Клавиатуры, Мыши и т.д.)
model Category {
  id       String    @id @default(cuid())
  name     String    @unique  // "Мониторы", "Клавиатуры" и т.д.
  slug     String    @unique  // "monitors", "keyboards" — для фильтрации
  icon     String?            // Название иконки из lucide-react
  order    Int       @default(0)  // Порядок отображения в UI

  products Product[]

  createdAt DateTime @default(now())
}

// Товар (конкретная периферия)
model Product {
  id             String   @id @default(cuid())
  name           String              // "LG 27UL850-W"
  description    String?             // Краткое описание
  price          Float               // Цена в рублях
  imageUrl       String?             // URL изображения
  connectionType String              // "USB", "XLR", "Wireless", "HDMI", "USB-C" и т.д.
  features       String   @default("[]") // JSON-массив характеристик: ["4K", "HDR", "IPS"]
  weight         Float?              // Вес в граммах (для проверки совместимости)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())

  @@index([categoryId])
}
